<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainActivityTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/window_bg</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="weather_theme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/app_top_bar_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="WeatherWidgetConfigureTheme" parent="weather_theme">
        <item name="android:windowBackground">@drawable/list_bg</item>
    </style>


    <style name="PrivacyDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/privacy_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/privacy_dialog_exit</item>
    </style>
</resources>
